# Environments
.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Claude local artifacts
/.claude/

# Lab raw data can be large; corpus records are committed, raw API dumps are not
lab/corpus/raw/*.json

# Benchmark results ARE committed (evidence), but scratch outputs are not
benchmarks/results/_scratch/

# Test-run caches. Not merely noise: tools/assemble_release.py runs the gate
# INSIDE the staged public tree, so without this the staging directory grows
# a .hypothesis/ and a .pytest_cache/ that a careless sync would publish.
.hypothesis/
.pytest_cache/

# OS noise
Thumbs.db
.DS_Store

# Derived corpus index (rebuild with lab/cli/rebuild_index.py)
lab/corpus/index.sqlite

# ⛔ PUBLIC REPO: the to-do list is not published (owner directive, 2026-08-29).
# These notes are the most candid writing in the repo - what is broken, what is half-built, what is
# waiting on a person - and Odin's Loki files them here automatically from chat history. The
# folder's own README stays tracked (it is already tracked, and it states the convention); only the
# items are ignored. Managed by public_todo_guard.py in the Odin repo.
/docs/todo/*
!/docs/todo/README.md
